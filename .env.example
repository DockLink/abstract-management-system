# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth + Storage
# Dashboard: Settings > API Keys (`supabase start` prints local keys)
SUPABASE_URL=http://127.0.0.1:54321
# Safe for the browser; replaces the legacy anon key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Server only, bypasses RLS; replaces the legacy service_role key.
# Never add a NEXT_PUBLIC_ prefix and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Optional browser aliases (next.config falls back to SUPABASE_* above)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App URL used for server-side API fetches
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth invite redirect
AUTH_INVITE_REDIRECT_URL=http://localhost:3000/login

# Swagger in production
# ENABLE_API_DOCS=true

# Local / bootstrap seed (yarn prisma:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# SEED_ADMIN_FULL_NAME=Platform Admin
# SEED_ORG_NAME=Demo Medical College
# SEED_ORG_SLUG=demo-college
